---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout>
  <p><a href="/" onclick="history.back(); return false;">til baka</a></p>
  <h1>{frontmatter.title}</h1>
  {
    frontmatter.date && (
      <>
        <time class="text-sub">{frontmatter.date}</time>
        <br />
        <br />
      </>
    )
  }
  <slot />
</Layout>
