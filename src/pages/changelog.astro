---
import Layout from "../layouts/Layout.astro";
import Entry from "../components/Entry.astro";

type commit = {
  message: string[];
  date: string;
};

type logEntry = {
  commit: {
    message: string;
    author: {
      date: string;
    };
  };
};

async function getData() {
  const url = "https://api.github.com/repos/valurkristinn/valur.me/commits";

  try {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`Response status: ${response.status}`);
    }

    const result = await response.json();
    return result;
  } catch (e) {
    console.error("Fetch failed:");
  }
}

const data: logEntry[] = await getData();

const refinedData: commit[] = data.map((c) => {
  const splitDate = c.commit.author.date.split("T")[0].split("-");
  const formattedDate = splitDate.reverse().join("-");
  return {
    message: c.commit.message.split("\n"),
    date: formattedDate,
  };
});

console.log(data[0]);
---

<Layout>
  <p></p>
  <ul>
    {
      refinedData.map((commit) => (
        <li>
          <Entry
            title={commit.message[0]}
            date={commit.date}
            body={commit.message.splice(1, commit.message.length)}
          />
        </li>
      ))
    }
  </ul>
</Layout>
