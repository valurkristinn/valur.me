---
import Layout from "../layouts/Layout.astro";

const modules = import.meta.glob("../projects/*.md", { eager: true });
const images = Object.values(modules)
  .map((m: any) => m.frontmatter?.content)
  .filter(Boolean);
---

{images.map((src) => <link rel="prefetch" as="image" href={src} />)}
<Layout>
  <p class="!mb-24">Hæ, velkomin/n á <br />vefsíðuna mína</p>
  <div class="*:text-lg">
    <p>
      Ég heiti <span class="font-semibold"> Valur </span> og ég hef gaman að forritun
      og hugbúnaði, ég er að læra hugbúnaðarverkfræði í Háskóla Íslands og starfa
      þar líka sem aðstoðarkennari.
    </p>
    <p>
      Hægt er að sjá reynslu og menntun mína <a href="/details">hér</a>
    </p>
    <p>
      Mér finnst gaman að takast á við krefjandi verkefni og að læra nýjar
      hugmyndir og leiðir til að nálgast lausnir... WIP
    </p>
  </div>
</Layout>
