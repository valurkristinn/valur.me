---
import Layout from "../layouts/Layout.astro";
import Entry from "../components/Entry.astro";

type MarkdownProject = {
  url: string;
  frontmatter: {
    title: string;
    desc: string;
    date: string;
    image: string;
    content: string;
  };
};

const projects = Object.values(
  import.meta.glob<MarkdownProject>("./projects/*.md", { eager: true }),
);
---

<Layout>
    <ul>
      {
        projects.map((project) => (
          <li>
            <Entry
              title={project.frontmatter.title}
              href={project.url}
              body={project.frontmatter.desc}
              date={project.frontmatter.date}
              content={project.frontmatter.content}
            />
          </li>
        ))
      }
    </ul>
</Layout>
