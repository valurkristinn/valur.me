---
const pathname = new URL(Astro.request.url).pathname;

const posts = Object.values(import.meta.glob("../pages/posts/*.md"));

const navItems = [
  { name: "Heim", href: "/" },
  { name: "Nánar um mig", href: "/details/" },
  { name: "Verkefni", href: "/projects/" },
  { name: "Tæki og tól", href: "/tools/" },
  ...(posts.length > 0 ? [{ name: "Færslur", href: "/posts/" }] : []),
  // { name: "Uppfærslusaga", href: "/changelog/" },
];

let index = -1;

navItems.forEach((navItem, i) => {
  if (
    navItem.href === "/" ? pathname === "/" : pathname.startsWith(navItem.href)
  ) {
    index = i;
  }
});
---

<nav class="flex flex-wrap gap-6 ">
  {
  navItems.map((navItem, i) => (
      <a
        href={navItem.href}
        class=`md:text-lg my-3 ${index !== i && "!text-main"}`
      >
        {navItem.name}
      </a>
    ))
  }
</nav>
