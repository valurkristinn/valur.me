---
const pathname = new URL(Astro.request.url).pathname;
const navItems = [
  { name: "Heim", href: "/" },
  { name: "Nánar um mig", href: "/details/" },
  { name: "Verkefni", href: "/projects/" },
  { name: "Tæki og tól", href: "/tools/" },
  { name: "Færslur", href: "/posts/" },
  { name: "Uppfærslusaga", href: "/changelog/" },
];

let index = -1;

navItems.forEach((navItem, i) => {
  if (
    navItem.href === "/" ? pathname === "/" : pathname.startsWith(navItem.href)
  ) {
    index = i;
  }
});
---

<nav class="sm:justify-between flex flex-wrap">
  {
  navItems.map((navItem, i) => (
      <a
        href={navItem.href}
        class=`md:text-lg m-1 ${index !== i && "!text-main"}`
      >
        {navItem.name}
      </a>
    ))
  }
</nav>
