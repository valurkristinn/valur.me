---
import Entry from "../Entry.astro";

type commit = {
  message: string[];
  date: string;
};

type logEntry = {
  commit: {
    message: string;
    author: {
      date: string;
    };
  };
};

async function getData() {
  const url = "https://api.github.com/repos/valurkristinn/valur.me/commits";

  try {
    const response = await fetch(url, {
      headers: {
        "User-Agent": "valur.me",
      },
    });

    if (!response.ok) {
      throw new Error(`Response status: ${response.status}`);
    }

    const result = await response.json();
    return result;
  } catch (e) {
    console.error(e);
    return [];
  }
}

const data: logEntry[] = (await getData()) || [];

const refinedData: commit[] = data.map((c) => {
  const splitDate = c.commit.author.date.split("T")[0].split("-");
  const formattedDate = splitDate.reverse().join("-");
  return {
    message: c.commit.message.split("\n"),
    date: formattedDate,
  };
});
---

<section>
  <p>Hér má sjá breytingarsögu síðunnar</p>
  <ul>
    {
      refinedData.map((commit) => (
        <li>
          <Entry
            title={commit.message[0]}
            date={commit.date}
            body={commit.message.slice(1, commit.message.length)}
          />
        </li>
      ))
    }
  </ul>
</section>
