<style>
  p:first-child {
    margin-bottom: var(--space-lg);
  }

  button {
    padding: var(--space-tiny);
  }
</style>

<script>
  const root = document.documentElement;
  const button = document.querySelector("small button")!;

  button.ariaPressed = String(root.hasAttribute("data-dark"));
  button.addEventListener("click", () => {
    const dark = root.toggleAttribute("data-dark");
    localStorage.dark = dark ? "1" : "";
    button.ariaPressed = String(dark);
  });
</script>
