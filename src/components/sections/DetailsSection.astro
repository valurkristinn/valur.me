---
import Entry from "../Entry.astro";
import data from "../../data/data.json" with { type: "json" };

const languages = data.skills.technical[0].split(":")[1];
const frameworks = data.skills.technical[1].split(":")[1];
---

<section>
  <section class="mb-12 pt-8 xl:pt-0" id="details">
    <p>
      Ég hef mikinn áhuga á reikniritum og bakendaforritun og hef einnig gaman
      að hönnun og framendaforritun, uppáhalds tungumálið mitt er C en ég hef þó
      reynslu af mun fleiri forritunarmálum og þróunarumhverfum sem sjá má hér á
      eftir, endilega skoðaðu reynslu og menntun mína þar á eftir
    </p>
    <p class="sub">{languages}</p>
    <p class="sub">{frameworks}</p>
  </section>

  <button
    type="button"
    aria-pressed="true"
    class="text-sub hover:text-main hover:cursor-pointer text-2xl mr-8"
    >Reynsla</button
  >
  <button
    type="button"
    aria-pressed="false"
    class="text-sub hover:text-main hover:cursor-pointer text-2xl"
    >Menntun</button
  >
  <h1 class="h-0 text-[0] !m-0"></h1>
  <section class="tab">
    {
      data.experience.map((e) => (
        <Entry
          title={e.title}
          subtitle={e.company}
          body={e.description}
          date={e.period}
        />
      ))
    }
  </section>
  <section class="tab hidden">
    {
      data.education.map((e) => (
        <Entry title={e.degree} subtitle={e.institution} date={e.period} />
      ))
    }
  </section>
</section>

<style>
  [aria-pressed="true"] {
    color: var(--color-accent);
  }
</style>

<script>
  const buttons = document.querySelectorAll("button");
  const tabs = document.querySelectorAll(".tab");

  let lastClicked = buttons[0];

  buttons.forEach((b) => {
    b.addEventListener("click", () => {
      if (lastClicked === b) return;
      tabs.forEach((t) => {
        t.classList.toggle("hidden");
      });
      buttons.forEach((b) => {
        b.ariaPressed = b.ariaPressed === "true" ? "false" : "true";
      });
      lastClicked = b;
    });
  });
</script>
