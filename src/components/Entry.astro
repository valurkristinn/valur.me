---
import { Image } from "astro:assets";

const { title, subtitle, body, date, href, content } = Astro.props;

const linkRegex = /(\S+\.is)/g;

const isImage = content?.includes("image");
const isVideo = content?.includes("video");
---

<article>
  {
    title &&
      (href ? (
        <a href={href} class="contents">
          <h3 class="!mb-2 !mt-10 hover:underline">{title}</h3>
        </a>
      ) : (
        <h3 class="!mb-2 !mt-10">{title}</h3>
      ))
  }

  {subtitle && <p class="sub">{subtitle}</p>}

  {
    body &&
      body.map((line: string) => (
        <p class="!m-0">
          {line.split(linkRegex).map((part) => {
            if (part.match(linkRegex)) {
              return <a href={`https://${part}`}>{part}</a>;
            }
            return part;
          })}
        </p>
      ))
  }

  {date && <p class="sub !mt-2">{date}</p>}

  {
    isImage && (
      <Image
        src={content}
        width={500}
        height={300}
        alt={"Lýsandi mynd fyrir " + title}
      />
    )
  }
  {
    isVideo && (
      <video>
        <source src={content} type="video/webm" />
      </video>
    )
  }
</article>
