---
import { Image } from "astro:assets";

const { title, subtitle, body, date, href, content } = Astro.props;

const linkRegex = /(\S+\.is)/g;

// images in src/assets 
// videos in public/video 
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{webp,png,jpg,jpeg}",
  { eager: true },
);

const isVideo = content?.endsWith(".webm");
const image = !isVideo && content ? images[`../assets/${content}`]?.default : undefined;
---

<article>
  {
    title &&
      (href ? (
        <a href={href} class="contents">
          <h3 class="!mb-2 !mt-10 hover:underline">{title}</h3>
        </a>
      ) : (
        <h3 class="!mb-2 !mt-10">{title}</h3>
      ))
  }

  {subtitle && <p class="sub">{subtitle}</p>}

  {
    body &&
      body.map((line: string) => (
        <p class="!m-0">
          {line.split(linkRegex).map((part) => {
            if (part.match(linkRegex)) {
              return <a href={`https://${part}`}>{part}</a>;
            }
            return part;
          })}
        </p>
      ))
  }

  {date && <p class="sub !mt-2">{date}</p>}

  {
    image && (
      <Image
        src={image}
        width={768}
        densities={[1, 2]}
        alt={"Lýsandi mynd fyrir " + title}
        loading="lazy"
      />
    )
  }
  {
    isVideo && (
      <video style="width:100%;height:auto;">
        <source src={`/video/${content}`} type="video/webm" />
      </video>
    )
  }
</article>
